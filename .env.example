# Hermes / Aide — environment template (copy to .env locally; never commit .env)

# --- LLM ---
DEEPSEEK_API_KEY=

# --- WhatsApp Business API (Phase 1 pilot) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Auth (Phase 3+) ---
JWT_SECRET=change-me-in-production
ZITADEL_ISSUER=

# --- Data stores ---
DATABASE_URL=sqlite:///./data/hermes.db
REDIS_URL=redis://localhost:6379/0

# --- Integrations (Phase 1+) ---
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
FIREFLY_BASE_URL=http://localhost:8080
NOCODB_BASE_URL=http://localhost:8081

# --- Ops ---
TZ=Asia/Hong_Kong
LOG_LEVEL=INFO
TOKEN_DAILY_LIMIT=50000
HERMES_PROFILE=pilot

# --- Domain / TLS (fill in when at office) ---
PUBLIC_DOMAIN=
CADDY_EMAIL=
