FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

COPY pyproject.toml README.md ./
COPY services ./services

RUN pip install --upgrade pip && pip install .

EXPOSE 8000

CMD ["uvicorn", "pilot_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
